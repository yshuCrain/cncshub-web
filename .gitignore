# ⚠️ 这里原来是 assets/ —— 它会把整个 assets 目录（含 css/js）一起忽略，
# 导致样式与脚本迁进 assets/ 后全部脱离版本控制。已改为只忽略二进制资源。

# 图片
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.webp

# 音频
*.mp3
*.wav
*.ogg
*.flac

# 视频
*.mp4
*.webm
*.mov

# 字体（可选，如果不想跟踪字体文件就保留这几行）
*.woff
*.woff2
*.ttf
*.otf

# 压缩包
*.zip
*.rar
*.7z

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器配置
.vscode/
.idea/

# ---------------- 显式放行：源码必须入库 ----------------
# 用 ! 取反，确保上面任何一条二进制规则都不会误伤样式与脚本。
!assets/css/
!assets/css/**
!assets/js/
!assets/js/**

# ---------------- 可选：让 SVG 图标与字体也入库 ----------------
# 目前上面 *.svg / *.woff2 会把它们排除。站点运行时依赖这些资源，
# 如果部署方式是 git clone，取消下面几行注释即可一并入库。
# !assets/images/**/*.svg
# !assets/fonts/**/*.woff2

# 原创几何地图标志是可编辑的矢量源码，随页面一起维护。
!assets/images/servicemaps/marks/*.svg
!assets/images/rookie-guides/head-height-lineart.svg

# Dust2 教学正文依赖的已确认素材。
!assets/images/servicemaps/dust2/*.png
!assets/images/servicemaps/dust2/*.webp

# 本地 SSH 密钥
/.ssh/

# ---------------- Node / Vite 构建层 ----------------
# node_modules 是「脚手架仓库」：只要执行 npm install 就能一模一样还原，
# 它体积大、变动频繁，必须进 gitignore，否则一次安装就能刷出上千条改动。
node_modules/

# dist 是 Vite 的构建产物，属于「编译结果」而非源码。
# 同理还有 Vite 的本地缓存目录。
dist/
.vite/
*.local
